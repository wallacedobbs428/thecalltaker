{
  "policy_id": "autonomous-reply-policy-v1",
  "status": "active",
  "principle": "Inbound Agent can answer low-risk replies inside approved policy. Escalate trust-risk, custom promises, known relationships, and provider/platform blocks.",
  "autonomous_allowed_categories": [
    "asks_what_it_does",
    "asks_for_website",
    "gives_advice",
    "sounds_interested",
    "asks_basic_pricing",
    "not_interested_polite_close",
    "spam_irrelevant_archive"
  ],
  "escalation_categories": [
    "investor_interest",
    "custom_pricing",
    "legal_contract_details",
    "angry_sensitive",
    "asks_for_unverified_proof",
    "asks_for_meeting_with_wallace",
    "known_personal_relationship",
    "current_customer",
    "provider_block"
  ],
  "send_gate": {
    "autonomous_reply_allowed_if": [
      "category autonomous_allowed is true",
      "reply uses approved facts",
      "no custom promise",
      "provider_status is connected",
      "channel limits and quiet hours pass",
      "lead is not marked personal_or_sensitive",
      "escalation_required is false"
    ],
    "otherwise": "draft_reply_and_escalate_or_wait_for_provider"
  },
  "logging_required": [
    "ctos/inbound/inbound-message-history.jsonl",
    "ctos/inbound/inbound-response-queue.json",
    "ctos/leads/unified-lead-pipeline.json"
  ]
}
