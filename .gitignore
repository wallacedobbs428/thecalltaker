# Local Netlify folder
.netlify

# Local environment files. Keep placeholders committed, never real secrets.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# Node dependencies
node_modules/

# Generated ad video outputs
ads/videos/

# Private local outreach inputs/outputs. Do not commit real prospect data.
tools/outreach/private/
tools/outreach/output/private/
tools/creative/private/
tools/creative/output/private/
tools/social/private/
tools/social/output/private/

# Ops runtime artifacts (generated by engines, not source code)
ops/*-state.json
ops/*.log
ops/scored-leads-*.csv
ops/clean-leads-*.csv
ops/deliverability-health.json
ops/system-health.json
ops/errors.json
ops/call-log.json
ops/storm-log.json
ops/speed-log.json
ops/dm-log.json
ops/dm-list-today.json
ops/scraper-report.json
ops/*.heartbeat
.gstack/

# macOS / editor noise
.DS_Store
**/.DS_Store

# Local backup / generated report variants
website/index.html.bak-*
ops/health-check-report.json
website/shopper-reports/[0-9]*.html
internal-pages/shopper-reports/[0-9]*.html
