    {
      "@type": "FAQPage",
      "@id": "https://thecalltaker.com/#faqpage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is an AI receptionist?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An AI receptionist is software that answers your business phone calls using natural-sounding artificial intelligence. It greets callers, answers their questions, books appointments, takes messages, and sends you a text summary of every call. Unlike voicemail, it actually talks to the caller in real time. Unlike a human receptionist, it works 24 hours a day, 7 days a week, and costs a fraction of the price."
          }
        },
        {
          "@type": "Question",
          "name": "How much does an AI receptionist cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Call Taker starts at $97 per month for after-hours coverage. The 24/7 Call Coverage plan is $497 per month, and Custom Call Coverage starts at $997 per month. Wallace reviews fit, call flow, launch details, and the correct payment link before service goes live."
          }
        },
        {
          "@type": "Question",
          "name": "Can an AI receptionist book appointments?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Call Taker books appointments directly during the phone call. It checks availability, confirms the time with the caller, and adds the appointment to your calendar. You get a text notification with the details. No back-and-forth emails or missed callbacks required."
          }
        },
        {
          "@type": "Question",
          "name": "What industries does The Call Taker work for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Call Taker works for HVAC companies, plumbers, electricians, dentists, dental offices, law firms, towing companies, locksmiths, roofing contractors, medical spas, veterinary clinics, property management companies, funeral homes, garage door repair, pest control, auto repair shops, and cleaning companies. The AI adapts its responses to your specific industry and business needs."
          }
        },
        {
          "@type": "Question",
          "name": "How is an AI receptionist different from voicemail?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "80% of callers hang up when they hit voicemail. An AI receptionist answers the call live, has an actual conversation, answers the caller's questions, and can book an appointment on the spot. Instead of a missed opportunity sitting in a voicemail box, you get a booked job and a text summary. The difference in revenue can be thousands of dollars per month for a busy service business."
          }
        },
        {
          "@type": "Question",
          "name": "How fast can I set up The Call Taker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Setup timing depends on the plan and approved call flow. Wallace confirms your services, hours, service area, urgent-call rules, and follow-up details before Gideon goes live. No hardware or software install is required."
          }
        },
        {
          "@type": "Question",
          "name": "Does The Call Taker work after hours?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The most popular use case is after-hours call answering. When your office closes, The Call Taker picks up every call, handles emergencies, books appointments for the next day, and sends you a text with each call summary. No more lost leads overnight or on weekends."
          }
        },
        {
          "@type": "Question",
          "name": "How does The Call Taker compare to Smith.ai or Ruby?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Smith.ai and Ruby use human receptionists and charge $200 to $1,000+ per month with per-minute or per-call fees. The Call Taker uses AI to answer calls for a flat $97 per month with no per-minute charges. The AI is available 24/7 with no hold times. For businesses that need affordable, around-the-clock call coverage without unpredictable bills, The Call Taker is significantly less expensive."
          }
        },
        {
          "@type": "Question",
          "name": "Can I review The Call Taker before paying?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Request setup review first. Wallace confirms fit, launch details, and the correct payment link before any payment is collected."
          }
        },
        {
          "@type": "Question",
          "name": "What happens when someone calls my business with The Call Taker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The AI answers within 2 rings using a natural-sounding voice. It greets the caller by your business name, asks how it can help, and handles the conversation. It can answer common questions about your services and hours, book appointments, take emergency information, and collect caller details. After the call ends, you receive a text message with a full summary of what was discussed and any actions taken."
          }
        }
      ]
    },
