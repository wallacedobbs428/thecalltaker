# Sentry / observability
# Browser DSN is public by design and is returned by the observability-config
# Netlify Function. Server DSN is used only inside Netlify Functions.
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
TCT_OBSERVABILITY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# Set true only during a supervised test window.
TCT_ENABLE_OBSERVABILITY_TEST=false

# Meta Instagram webhook verification token.
META_VERIFY_TOKEN=calltaker_ig_webhook_2026_wallace
