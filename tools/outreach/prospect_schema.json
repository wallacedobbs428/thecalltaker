{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Call Taker Outreach Prospect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "business_name",
    "industry",
    "category",
    "phone",
    "website",
    "city",
    "state",
    "source_url",
    "hours_signal",
    "emergency_signal",
    "missed_call_risk_notes",
    "current_answering_path",
    "service_area_notes",
    "review_signal",
    "ad_spend_signal",
    "contact_person",
    "contact_role",
    "email_if_public",
    "proof_angle",
    "outreach_angle",
    "objection_prediction",
    "score",
    "score_category",
    "next_action",
    "owner",
    "status",
    "compliance_notes",
    "last_touch",
    "next_touch",
    "created_at",
    "updated_at",
    "signals"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "business_name": { "type": "string", "minLength": 1 },
    "industry": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "phone": { "type": "string", "minLength": 1 },
    "website": { "type": "string", "minLength": 1 },
    "city": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 2 },
    "source_url": { "type": "string", "minLength": 1 },
    "hours_signal": { "type": "string" },
    "emergency_signal": { "type": "string" },
    "missed_call_risk_notes": { "type": "string" },
    "current_answering_path": { "type": "string" },
    "service_area_notes": { "type": "string" },
    "review_signal": { "type": "string" },
    "ad_spend_signal": { "type": "string" },
    "contact_person": { "type": "string" },
    "contact_role": { "type": "string" },
    "email_if_public": { "type": "string" },
    "proof_angle": { "type": "string" },
    "outreach_angle": { "type": "string" },
    "objection_prediction": { "type": "string" },
    "score": { "type": ["number", "null"] },
    "score_category": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", null] },
    "next_action": { "type": "string" },
    "owner": { "type": "string", "enum": ["Wallace", "system", "later"] },
    "status": {
      "type": "string",
      "enum": ["research", "ready", "contacted", "demo_sent", "call_needed", "won", "lost", "nurture"]
    },
    "compliance_notes": { "type": "string" },
    "last_touch": { "type": ["string", "null"] },
    "next_touch": { "type": ["string", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "data_source": { "type": "string" },
    "import_status": { "type": "string", "enum": ["normalized", "rejected"] },
    "review_required": { "type": "boolean" },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_reachable",
        "service_area_business",
        "right_size",
        "emergency_service",
        "after_hours_need",
        "seasonal_spike",
        "website_contact_friction",
        "review_pain",
        "call_path_issue",
        "high_value_call",
        "ad_spend_visible",
        "strong_reviews",
        "multiple_crews_or_locations",
        "public_phone_works",
        "public_email_or_form",
        "social_active",
        "local_or_strategic_market",
        "clear_proof_angle",
        "safe_secret_shopper_angle",
        "demo_preview_fit",
        "fits_after_hours_capture",
        "fits_revenue_recovery",
        "fits_operational_infrastructure",
        "deductions"
      ],
      "properties": {
        "owner_reachable": { "type": "boolean" },
        "service_area_business": { "type": "boolean" },
        "right_size": { "type": "boolean" },
        "emergency_service": { "type": "boolean" },
        "after_hours_need": { "type": "boolean" },
        "seasonal_spike": { "type": "boolean" },
        "website_contact_friction": { "type": "boolean" },
        "review_pain": { "type": "boolean" },
        "call_path_issue": { "type": "boolean" },
        "high_value_call": { "type": "boolean" },
        "ad_spend_visible": { "type": "boolean" },
        "strong_reviews": { "type": "boolean" },
        "multiple_crews_or_locations": { "type": "boolean" },
        "public_phone_works": { "type": "boolean" },
        "public_email_or_form": { "type": "boolean" },
        "social_active": { "type": "boolean" },
        "local_or_strategic_market": { "type": "boolean" },
        "clear_proof_angle": { "type": "boolean" },
        "safe_secret_shopper_angle": { "type": "boolean" },
        "demo_preview_fit": { "type": "boolean" },
        "fits_after_hours_capture": { "type": "boolean" },
        "fits_revenue_recovery": { "type": "boolean" },
        "fits_operational_infrastructure": { "type": "boolean" },
        "deductions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "national_franchise",
            "strong_existing_solution",
            "missing_sources",
            "sensitive_category",
            "terms_risk",
            "sms_compliance_uncertain"
          ],
          "properties": {
            "national_franchise": { "type": "boolean" },
            "strong_existing_solution": { "type": "boolean" },
            "missing_sources": { "type": "boolean" },
            "sensitive_category": { "type": "boolean" },
            "terms_risk": { "type": "boolean" },
            "sms_compliance_uncertain": { "type": "boolean" }
          }
        }
      }
    }
  }
}
